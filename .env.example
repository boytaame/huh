# Copy to .env.local and fill in. Never commit .env.local.

# gemini | anthropic | openai
LLM_PROVIDER=gemini

# Server-side only. Never exposed to the browser.
# Optional in practice: visitors can bring their own key via the top-right box,
# in which case their browser calls the provider directly and this key is unused.
LLM_API_KEY=

# Optional. Defaults to a fast vision model for the chosen provider:
#   gemini    -> gemini-3.8-flash
#   anthropic -> claude-haiku-4-5
#   openai    -> gpt-4o-mini
LLM_MODEL=

# tldraw license key. Starts with NEXT_PUBLIC_ because license keys are
# validated client-side and are safe to ship in the browser bundle.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
