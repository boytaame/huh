# Copy to .env.local and fill in. Never commit .env.local or any real key.

# ---------- LLM provider (server-side) ----------

# gemini | anthropic | openai
LLM_PROVIDER=

# Server-side only, never sent to the browser. Visitors can also bring their
# own key in the top-right box, in which case their browser calls the provider
# directly and this key is unused.
LLM_API_KEY=

# Optional. Empty uses the provider default (gemini-3.6-flash,
# claude-haiku-4-5, or gpt-4o-mini).
LLM_MODEL=

# ---------- Rate limiting (Upstash Redis, optional but required in production) ----------

# Without these two the app still runs locally with an in-memory limiter,
# which does not hold across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per anonymous client cookie (huh_cid), default 30.
RATE_LIMIT_CLIENT_DAILY=

# Per IP burst, default 10 requests per minute.
RATE_LIMIT_IP_PER_MIN=

# Per IP daily, default 100.
RATE_LIMIT_IP_DAILY=

# Total asks per UTC day across the whole deployment, default 500.
GLOBAL_DAILY_ASK_CAP=

# Feedback posts per anonymous client per day, default 60.
RATE_LIMIT_FEEDBACK_CLIENT_DAILY=

# ---------- Feedback admin ----------

# Long random string required by GET /api/feedback (x-admin-token header).
ADMIN_TOKEN=

# ---------- Analytics (PostHog, optional) ----------

# Empty disables analytics completely (no network requests).
NEXT_PUBLIC_POSTHOG_KEY=

# Optional, defaults to https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# ---------- Contact / legal ----------

# Shown on the draft /privacy and /terms pages. Also powers the "Report a bug"
# mailto fallback when NEXT_PUBLIC_BUG_FORM_URL is empty.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. If set (e.g. a Google Form), "Report a bug" opens this URL in a new
# tab. It is used as-is; no query parameters are appended.
NEXT_PUBLIC_BUG_FORM_URL=

# ---------- tldraw license ----------

# Public by design: tldraw validates license keys client-side. Empty is fine
# for dev and a classmates-only demo; check tldraw's terms before launching.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# ---------- Sentry (reserved, not wired up yet) ----------

# Spec-addendum-3 D7 marks Sentry optional; this session skipped the SDK
# install (see PROGRESS.md). These are placeholders for a later session.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
